# GCP Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash

# Optional: cost estimation (USD per 1M tokens)
# VERTEX_INPUT_COST_PER_M=0.15
# VERTEX_OUTPUT_COST_PER_M=0.60

# Optional: rate limit tuning
# VISIONTAG_SLEEP=1.0
# VISIONTAG_RETRY_PASSES=5
# VISIONTAG_RETRY_SLEEP=45

# Optional: auth via service account key instead of gcloud login
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
